---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  repoUrl?: string;
  liveUrl?: string;
  tags: string[];
  image?: ImageMetadata;
}

const { title, description, repoUrl, liveUrl, tags, image } = Astro.props;
---

<article
  class="group flex flex-col overflow-hidden rounded-2xl border border-page-text/80 transition-all hover:border-page-text/40 xs:flex-row">
  {
    image && (
      <div class="aspect-4/3 w-full shrink-0 overflow-hidden bg-nav group-hover:opacity-75 xs:w-36 md:w-64">
        <Image
          src={image}
          alt={title}
          width={800}
          height={600}
          class="h-full w-full object-cover object-top duration-300"
        />
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-4">
    <h3>{title}</h3>

    <p>
      {description}
    </p>

    {
      (repoUrl || liveUrl) && (
        <p class="flex gap-3">
          {repoUrl && (
            <a class="btn-secondary" href={repoUrl}>
              Code &#8599;
            </a>
          )}
          {liveUrl && (
            <a class="btn-primary" href={liveUrl}>
              Live &#8599;
            </a>
          )}
        </p>
      )
    }
    <ul
      class="m-0 mt-auto flex list-none flex-wrap p-0 text-xs text-text-faded">
      {
        tags.map((tag, index) => (
          <li>{`${tag}${index < tags.length - 1 ? ",\u00A0" : ""}`}</li>
        ))
      }
    </ul>
  </div>
</article>
