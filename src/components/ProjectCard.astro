---
interface Props {
  title: string;
  description: string;
  repoUrl?: string;
  liveUrl?: string;
  tags: string[];
}

const { title, description, repoUrl, liveUrl, tags } = Astro.props;
---

<article class="flex flex-col rounded-2xl border p-4">
  <h3>{title}</h3>

  <p>
    {description}
  </p>

  {
    (repoUrl || liveUrl) && (
      <p class="flex">
        {repoUrl && (
          <a class="pr-4" href={repoUrl}>
            Code &rarr;
          </a>
        )}
        {liveUrl && <a href={liveUrl}>Live &rarr;</a>}
      </p>
    )
  }

  <ul class="m-0 mt-auto flex list-none flex-wrap p-0 text-xs text-text-faded">
    {
      tags.map((tag, index) => (
        <li>{`${tag}${index < tags.length - 1 ? ",\u00A0" : ""}`}</li>
      ))
    }
  </ul>
</article>
