---
const currentPath = Astro.url.pathname;

const links = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/projects", label: "Projects" },
  { href: "/work", label: "Work" },
];

// Return true if the given href matches or is a prefix of the current path.
// Root is matched exactly to avoid marking every page as active.
function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(href);
}
---

<nav
  id="main-menu"
  aria-label="Main"
  class="absolute top-full right-0 left-0 z-50 hidden bg-nav sm:static sm:block sm:bg-transparent">
  <ul class="m-0 list-none p-0 sm:flex sm:items-center sm:gap-1">
    {
      links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={isActive(href) ? "page" : undefined}
            class:list={[
              "block px-4 py-3 font-semibold text-page-text no-underline",
              "hover:bg-nav-hover",
              "sm:rounded sm:px-3 sm:py-1",
              isActive(href) ? "bg-nav-active" : false,
            ]}>
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
