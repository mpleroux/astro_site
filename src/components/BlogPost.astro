---
interface Props {
  date: Date;
  url: string;
  title: string;
}

const { date, url, title } = Astro.props;

const d = new Date(date);
const formattedDate = `${d.toLocaleDateString("en-US", { month: "short", timeZone: "UTC" })} ${d.getUTCDate()}, ${d.getUTCFullYear()}`;
---

<li>
  {formattedDate}: <a href={url}>{title}</a>
</li>
