---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = [
  {
    title: "Web Bookmarks",
    description:
      "A website bookmarking site modeled on Pinboard using React and Next.js. Work-in-progress.",
    repoUrl: "https://github.com/mpleroux/web_bookmarks",
    liveUrl: "https://mleroux-web-bookmarks.netlify.app/",
    tags: ["React", "TypeScript", "Next.js", "Tailwind CSS", "Supabase"],
  },
  {
    title: "Trivia Quiz",
    description: "Multiple choice trivia game using React and Open Trivia DB.",
    repoUrl: "https://github.com/mpleroux/trivia_quiz",
    liveUrl: "https://mpleroux-trivia-quiz.netlify.app/",
    tags: [
      "React",
      "Vite",
      "TypeScript",
      "Tailwind CSS",
      "Jest",
      "Open Trivia DB",
    ],
  },
  {
    title: "Astro Site",
    description:
      "This website! Astro handles the structure and Tailwind handles the styling.",
    repoUrl: "https://github.com/mpleroux/astro_site",
    tags: ["Astro", "Tailwind CSS", "TypeScript"],
  },
];

const pageTitle = "Projects";
const description =
  "Personal web development projects with links to code repos and live demos";
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  mainClass="md:max-w-4xl">
  <h1>{pageTitle}</h1>

  <section class="mb-8">
    <p>
      My GitHub account with many other repos is at <a
        href="https://github.com/mpleroux">github.com/mpleroux</a
      >.
    </p>
  </section>

  <section
    class="mb-8 grid grid-cols-1 gap-4 text-sm xs:grid-cols-2 md:grid-cols-3">
    {projects.map((project) => <ProjectCard {...project} />)}
  </section>

  <section>
    <p><b>Updates:</b></p>

    <ul>
      <li>
        I recently finished the extensive Next.js <a
          href="https://nextjs.org/learn/dashboard-app">App Router</a
        > course. My notes are at <a
          href="https://github.com/mpleroux/next_app_router/blob/main/README.md"
          >next_app_router</a
        >.
      </li>
      <li>
        Current project: <a href="https://github.com/mpleroux/web_bookmarks"
          >Web Bookmarks</a
        >
      </li>
    </ul>
  </section>
</BaseLayout>
