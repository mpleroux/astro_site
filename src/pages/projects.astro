---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

type Project = {
  title: string;
  description: string;
  repoUrl?: string;
  liveUrl?: string;
  tags: string[];
};

const nextProject: Project[] = [
  {
    title: "Feed Reader",
    description:
      "A single-user RSS/Atom feed reader built with Python and Django.",
    repoUrl: "https://github.com/mpleroux/feed_reader",
    tags: ["Python", "Django", "Feedparser", "Tailwind CSS"],
  },
];

const projects: Project[] = [
  {
    title: "Weather App",
    description:
      "A weather dashboard showing current conditions, today's forecast, and a 7-day forecast.",
    repoUrl: "https://github.com/mpleroux/weather_app",
    liveUrl: "https://mpleroux-weather-app.netlify.app/",
    tags: ["Vue.js", "Nuxt", "Nuxt UI", "Tailwind CSS", "Open-Meteo"],
  },
  {
    title: "Web Bookmarks",
    description:
      "Website bookmarking app modeled on Pinboard using React and Next.js.",
    repoUrl: "https://github.com/mpleroux/web_bookmarks",
    liveUrl: "https://mleroux-web-bookmarks.netlify.app/",
    tags: [
      "React",
      "TypeScript",
      "Next.js",
      "Tailwind CSS",
      "Supabase",
      "@supabase/ssr",
    ],
  },
  {
    title: "Trivia Quiz",
    description: "Multiple choice trivia game using React and Open Trivia DB.",
    repoUrl: "https://github.com/mpleroux/trivia_quiz",
    liveUrl: "https://mpleroux-trivia-quiz.netlify.app/",
    tags: [
      "React",
      "Vite",
      "TypeScript",
      "Tailwind CSS",
      "Jest",
      "Open Trivia DB",
    ],
  },
  {
    title: "Astro Site",
    description:
      "This website! Astro handles the structure and Tailwind handles the styling.",
    repoUrl: "https://github.com/mpleroux/astro_site",
    tags: ["Astro", "Tailwind CSS", "TypeScript"],
  },
];

const pageTitle = "Projects";
const description =
  "Personal web development projects with links to code repos and live demos";
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  mainClass="md:max-w-4xl">
  <h1>{pageTitle}</h1>

  <section class="mb-8">
    <p>
      My GitHub account with a bunch of other repos is at <a
        href="https://github.com/mpleroux">github.com/mpleroux</a
      >.
    </p>
  </section>

  {
    nextProject.length > 0 && (
      <>
        <h2>In Progress</h2>

        <section class="mb-8 grid grid-cols-1 gap-4 text-sm xs:grid-cols-2 md:grid-cols-3">
          {nextProject.map((project) => (
            <ProjectCard {...project} />
          ))}
        </section>
      </>
    )
  }

  <h2>Recent</h2>

  <section
    class="mb-8 grid grid-cols-1 gap-4 text-sm xs:grid-cols-2 md:grid-cols-3">
    {projects.map((project) => <ProjectCard {...project} />)}
  </section>
</BaseLayout>
